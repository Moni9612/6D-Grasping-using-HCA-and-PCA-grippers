<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur10_with_ap_full_gripper">

  <xacro:arg name="ur_type" default="ur10"/>
  <xacro:arg name="name" default="ur10"/>
  <xacro:arg name="tf_prefix" default=""/>

  <!-- Official UR description -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!-- TF gripper description -->
  <xacro:include filename="$(find tf_gripper_urdf)/urdf/TF Gripper URDF.urdf"/>

  <!-- Fixed world link required by UR macro -->
  <link name="world"/>

  <!-- Create UR10 -->
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml">

    <origin xyz="0 0 0" rpy="0 0 0"/>

  </xacro:ur_robot>

  <!-- Attach AP full gripper to UR10 wrist -->
  <joint name="ap_gripper_mount_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tf_gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 3.14159"/>
  </joint>

</robot>